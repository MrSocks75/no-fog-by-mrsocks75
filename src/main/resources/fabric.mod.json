{
	"schemaVersion": 1,
	"id": "nofogbymrsocks",
	"version": "${version}",
	"name": "No Fog by MrSocks",
	"description": "This is my basic attempt to do a no fog mod after the one I was using stopped getting updated.",
	"authors": [
		"MrSocks75"
	],
	"contact": {
		"homepage": "https://github.com/MrSocks75/no-fog-by-mrsocks75",
		"sources": "https://github.com/MrSocks75/no-fog-by-mrsocks75"
	},
	"license": "CC0-1.0",
	"icon": "assets/nofogbymrsocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.mrsocks.nofog.NoFogByMrSocks"
		],
		"client": [
			"dev.mrsocks.nofog.NoFogByMrSocksClient"
		]
	},
	"mixins": [
		{
			"config": "nofogbymrsocks.client.mixins.json",
			"environment": "client"
		}
